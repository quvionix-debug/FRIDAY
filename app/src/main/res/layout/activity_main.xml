<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cyber_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- Top Header HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.25"
                android:text="@string/title_friday"
                android:textColor="#00FFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/subtitle_jarvis"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/authorized_boss"
                android:textColor="#00FF66"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Status Badge -->
        <LinearLayout
            android:id="@+id/layoutStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/ic_pulse_dot" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/status_standby"
                android:textColor="#00FFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Interactive Area: Concentric Rings & Central Voice Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:gravity="center">

        <!-- Outer Glowing Ring -->
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_centerInParent="true"
            android:alpha="0.2"
            android:background="@drawable/bg_neon_circle" />

        <!-- Middle Ring -->
        <View
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_centerInParent="true"
            android:alpha="0.45"
            android:background="@drawable/bg_neon_circle" />

        <!-- Core Mic Button -->
        <LinearLayout
            android:id="@+id/btnMic"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_centerInParent="true"
            android:background="@drawable/btn_mic_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivMicIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/mic_icon_desc"
                android:src="@drawable/ic_mic_neon" />

            <TextView
                android:id="@+id/tvMicText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:text="@string/mic_active"
                android:textColor="#00FFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Mode & Trigger Subtext -->
    <TextView
        android:id="@+id/tvListeningState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:text="@string/status_continuous_listening"
        android:textColor="#00FFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWakeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/wake_hint"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <!-- System Permission Setup Banner for PIN Unlock & 24/7 BG -->
    <TextView
        android:id="@+id/btnSetupPermissions"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_action_chip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:letterSpacing="0.03"
        android:text="@string/permission_banner_text"
        android:textColor="#00FF66"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Live Telemetry & Conversation Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_neon_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/telemetry_log_header"
                android:textColor="#00FFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="@string/clear_logs"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#1E293B" />

        <ScrollView
            android:id="@+id/scrollLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvConversationLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="@string/initial_telemetry"
                android:textColor="#F8FAFC"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Quick Action / Voice Command Simulator Chips -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:letterSpacing="0.05"
        android:text="@string/cmd_simulator_header"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCmdWake"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cmd_wake_up"
            android:textColor="#00FFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnCmdUnlock"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cmd_unlock"
            android:textColor="#00FF66"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnCmdWhatsApp"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cmd_whatsapp"
            android:textColor="#00FFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnCmdYouTube"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cmd_youtube"
            android:textColor="#FF0055"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
